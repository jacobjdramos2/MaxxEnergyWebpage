{
    "java.compile.nullAnalysis.mode": "automatic",
    "java.project.sourcePaths": [
        "back-end/src/main/java"
    ],
    "java.project.resourcePaths": [
        "back-end/src/main/resources"
    ],
    "java.project.outputPath": "back-end/target/classes",
    "java.project.referencedLibraries": [
        "back-end/lib/**/*.jar"
    ],
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "back-end/target": true,
        "front-end/node_modules": true
    },
    "javascript.validate.enable": true,
    "typescript.validate.enable": true,

    "java.configuration.updateBuildConfiguration": "automatic",
    "maven.executable.path": "/usr/local/bin/mvn",
    "java.maven.downloadSources": true,
    "maven.pomfile.autoUpdateEffectivePOM": true,
    "java.import.maven.enabled": true,
    "maven.pomfile.globPattern": "**/pom.xml"
}
